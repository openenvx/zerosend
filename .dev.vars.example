# Operator secrets - enter these in Cloudflare's Deploy setup UI or copy to apps/zerosend/.dev.vars for local dev.
ADMIN_TOKEN=change-me-to-a-long-random-string
SESSION_SECRET=change-me-run-openssl-rand-hex-32
# Cloudflare API token for domain onboarding (Email Sending subdomains + DNS). Not required for zs_test_ sends.
CF_API_TOKEN=
