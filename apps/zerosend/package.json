{
  "name": "zerosend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:worker": "wrangler deploy",
    "deploy:with-migrations": "bun run db:migrate:remote && bun run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "^1.14.12",
    "@orpc/zod": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "@zerosend/api": "workspace:*",
    "@zerosend/ui": "workspace:*",
    "evlog": "^2.22.4",
    "lucide-react": "catalog:",
    "nitro": "^3.0.260610-beta",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
