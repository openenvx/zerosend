    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.4",
    "@zerosend/config": "workspace:*",
    "typescript": "catalog:",
    "vite": "^8.1.5",
    "wrangler": "^4.74.0"
  }
}
