{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerosend",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  // Omit database_id for one-click deploy; Cloudflare provisions D1 per account.
  // Remote migrations resolve the ID via `wrangler d1 list` (see scripts/d1-migrate-remote.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zerosend",
      "migrations_dir": "../../packages/db/src/migrations",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],
  // Omit id for one-click deploy; Cloudflare provisions KV per account.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
    },
  ],
}
