{
  "name": "zerosend",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@orpc/server": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "setup": "test -f apps/zerosend/.dev.vars || cp apps/zerosend/.dev.vars.example apps/zerosend/.dev.vars",
    "dev": "turbo run dev -F zerosend --",
    "dev:all": "turbo run dev --filter=zerosend --filter=landing",
    "dev:zerosend": "turbo run dev -F zerosend --",
    "dev:landing": "turbo run dev -F landing --",
    "build": "turbo run build -F zerosend --",
    "preview": "turbo run preview -F zerosend --",
    "check-types": "turbo run check-types --filter='!./apps/*'",
    "deploy": "turbo run deploy -F zerosend --",
    "deploy:zerosend": "turbo run deploy -F zerosend --",
    "deploy:landing": "turbo run deploy -F landing --",
    "deploy:with-migrations": "bun run db:migrate:remote && bun run deploy",
    "cf-typegen": "turbo run cf-typegen -F zerosend --",
    "db:generate": "turbo run db:generate -F @zerosend/db --",
    "db:migrate:local": "turbo run db:migrate:local -F zerosend --",
    "db:migrate:remote": "turbo run db:migrate:remote -F zerosend --",
    "migrate": "bun run db:migrate:local",
    "check": "ultracite check && knip",
    "precommit": "bun run check && turbo run check-types --filter='...[HEAD]' --filter='!./apps/*'",
    "knip": "knip",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "catalog:",
    "@zerosend/config": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.10.6",
    "wrangler": "^4.74.0"
  },
  "packageManager": "bun@1.3.14",
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "Operator password for the dashboard at `/login`. Use a long random string - this is **not** an API key."
      },
      "SESSION_SECRET": {
        "description": "Secret for signing session JWT cookies. Generate with `openssl rand -hex 32`."
      },
      "CF_API_TOKEN": {
        "description": "Cloudflare API token for onboarding sending domains in the dashboard (Email Sending subdomains + DNS). Not required for test sends."
      }
    }
  }
}
